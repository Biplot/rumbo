{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "rewrites": [
    {
      "source": "/api/push/",
      "destination": "/api/push"
    },
    {
      "source": "/api/libros/",
      "destination": "/api/libros"
    },
    {
      "source": "/api/norte/",
      "destination": "/api/norte"
    }
  ],
  "functions": {
    "api/push.js": {
      "includeFiles": "js/habitos-motor.js"
    },
    "api/norte.js": {
      "includeFiles": "js/habitos-motor.js"
    }
  }
}
